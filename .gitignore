# clasp (Apps Script deploy CLI) — .clasp.json cuma berisi scriptId, tapi
# tetap project-specific per orang, isi dari .clasp.json.example sendiri.
# .clasprc.json (kredensial OAuth clasp login) JANGAN PERNAH di-commit.
.clasp.json
.clasprc.json

# .clasp-pull.json dibuat sementara oleh .github/workflows/deploy-gas.yml
# (dan kalau meniru langkahnya secara lokal) cuma untuk `clasp pull` manifest
# ke folder terpisah — bukan konfigurasi yang perlu di-commit.
.clasp-pull.json

